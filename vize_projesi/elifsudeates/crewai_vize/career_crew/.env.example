# CareerCrew - Environment Configuration

# 1. Main LLM Settings (Default selection on startup)
LLM_PROVIDER="ollama"      # "ollama" or "gemini"

# 2. Ollama (Local) Configuration
OLLAMA_MODEL="llama3.1:8b" # The default model if none selected
OLLAMA_BASE_URL="http://localhost:11434"

# 3. Google Gemini Configuration
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GEMINI_MODEL="gemini-1.5-flash"

# 4. API & Storage Configuration
HOST="0.0.0.0"
PORT=8000
REPORTS_DIR="./reports"
INPUTS_DIR="./inputs"
